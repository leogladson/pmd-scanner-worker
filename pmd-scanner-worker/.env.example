# HTTP server
PORT=8080
# Shared secret — must match External Credential api_token (Bearer) sent from Salesforce
WORKER_API_TOKEN=change-me

# Salesforce integration user (Tooling API read + ContentVersion create + PMD_Scanner_Callback)
SF_LOGIN_URL=https://test.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=

# Optional overrides
# SF_API_VERSION=67.0
# CODE_ANALYZER_SF_BIN=sf
# CODE_ANALYZER_CONFIG_FILE=./config/code-analyzer.yml
# RULE_SELECTOR=pmd
# ANALYZER_TIMEOUT_MS=1800000
# MAX_CONCURRENT_JOBS=2
# JOB_WORK_ROOT=./.work
